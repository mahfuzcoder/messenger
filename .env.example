# Backend (local or Render)
PORT=3000
NODE_ENV=development

# MongoDB — local, or MongoDB Atlas for Render:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/nook_messenger?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nook_messenger
JWT_SECRET=replace-with-a-long-random-secret

# Extra browser origins allowed to call the API (comma separated).
# The service's own origin (e.g. https://your-app.onrender.com) needs no entry.
# Examples: http://localhost:5173,https://your-app.onrender.com,https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Required in production: photos/videos/voice notes on Cloudinary (Render's disk is temporary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Frontend deployed on Vercel (set at build time). Leave empty when Render serves the React build.
# VITE_API_URL=https://your-render-service.onrender.com
